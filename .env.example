# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon_key
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role_key

# Device JWT — generate with: openssl rand -hex 32 (use 64 chars for extra security)
DEVICE_JWT_SECRET=replace_with_64_char_random_hex_string

# Admin key — used by Kiyanna Flasher and dashboard x-admin-key header
# Generate with: openssl rand -hex 16
ADMIN_REGISTER_KEY=replace_with_32_char_random_hex_string

# Telegram alerts (Divindu's bot)
TELEGRAM_BOT_TOKEN=123456789:ABC-your-bot-token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Anthropic (for any AI features — Kiyanna devices use this via the returned api_base)
ANTHROPIC_API_KEY=sk-ant-...

# Per-device Island Loaf connection. Agent keys stay in this cloud environment,
# never in ESP32 firmware. Each key must belong to a vendor-scoped Kiyanna identity.
ISLANDLOAF_DEVICE_CONFIG_JSON={"KIYANNA-HOTEL-001":{"url":"https://vendor.example.com","agentKey":"kiyanna_..."}}

# Admin email
ADMIN_EMAIL=divindu@aicodeagency.org
NEXT_PUBLIC_ADMIN_EMAIL=divindu@aicodeagency.org
